#, c-format
msgid "Ticket #%u is now open. A helper will take it as soon as possible. You can keep sending messages here; they will be added to the ticket."
msgstr "Le ticket #%u est maintenant ouvert. Un membre de l'équipe va s'en occuper dès que possible. Vous pouvez continuer à envoyer des messages ici ; ils seront ajoutés au ticket."

#, c-format
msgid "[ DEMANDE D'AIDE ]"
msgstr "[ DEMANDE D'AIDE ]"

msgid "[ SIGNALEMENT ]"
msgstr "[ SIGNALEMENT ]"

#, c-format
msgid "%s — new ticket from %s ignored (%s)."
msgstr "%s — nouveau ticket de %s ignoré (%s)."

msgid "Please slow down. Wait a few seconds between messages."
msgstr "Merci de patienter quelques secondes entre les messages."

msgid "Repeated messages are ignored."
msgstr "Les messages répétés sont ignorés."

msgid "Please wait a few seconds after connecting before opening a ticket."
msgstr "Merci d'attendre quelques secondes après la connexion avant d'ouvrir un ticket."

msgid "You already opened a ticket recently. Please wait before opening another."
msgstr "Vous avez déjà ouvert un ticket récemment. Merci d'attendre avant d'en ouvrir un autre."

msgid "Too many tickets from your connection. You can still be helped: please wait, or identify to your account if you have one."
msgstr "Trop de tickets depuis votre connexion. Vous pouvez toujours être aidé : patientez, ou identifiez-vous si vous avez un compte."

#, c-format
msgid "[ DEMANDE D'AIDE ] ticket #%u"
msgstr "[ DEMANDE D'AIDE ] ticket #%u"

#, c-format
msgid "[ SIGNALEMENT ] ticket #%u"
msgstr "[ SIGNALEMENT ] ticket #%u"

#, c-format
msgid "%s — %s: %s"
msgstr "%s — %s : %s"

#, c-format
msgid "Your message has been added to ticket #%u."
msgstr "Votre message a été ajouté au ticket #%u."

#, c-format
msgid "Ticket #%u new message from %s: %s"
msgstr "Ticket #%u nouveau message de %s : %s"

#, c-format
msgid "%s — update from %s: %s"
msgstr "%s — mise à jour de %s : %s"

#, c-format
msgid "Image: %s"
msgstr "Image : %s"

#, c-format
msgid "Voice note: %s"
msgstr "Note vocale : %s"

#, c-format
msgid "File: %s"
msgstr "Fichier : %s"

msgid "Your file has been saved. It will be attached to the ticket once you describe the problem."
msgstr "Votre fichier a été enregistré. Il sera joint au ticket dès que vous aurez décrit le problème."

msgid "Tell me what is going wrong (what you tried, and the result). For how to use the chat: https://www.reseau-entrenous.fr/aide/"
msgstr "Dites-moi ce qui bloque (ce que vous avez essayé, et le résultat). Pour l'utilisation du tchat : https://www.reseau-entrenous.fr/aide/"

msgid "A little more detail will help: the nickname, the channel, or the exact error if you have one."
msgstr "Encore un peu de détail : le pseudo, le salon, ou le message d'erreur exact si vous en avez un."

msgid "Webchat: https://www.reseau-entrenous.fr/aide/webchat/"
msgstr "Webchat : https://www.reseau-entrenous.fr/aide/webchat/"

msgid "Nicknames (NickServ): https://www.reseau-entrenous.fr/aide/nickserv/"
msgstr "Pseudos (NickServ) : https://www.reseau-entrenous.fr/aide/nickserv/"

msgid "Personal channels (Gaya): https://www.reseau-entrenous.fr/aide/gaya/"
msgstr "Salons personnels (Gaya) : https://www.reseau-entrenous.fr/aide/gaya/"

msgid "Server help: https://www.reseau-entrenous.fr/aide/aide-serveur/"
msgstr "Aide serveur : https://www.reseau-entrenous.fr/aide/aide-serveur/"

msgid "Chat help: https://www.reseau-entrenous.fr/aide/"
msgstr "Aide du tchat : https://www.reseau-entrenous.fr/aide/"

msgid "If that is not it, describe the problem in a few words."
msgstr "Si ce n'est pas ça, décrivez le problème en quelques mots."

msgid "If that page is not enough, describe the problem in a few words (what you tried, and the error)."
msgstr "Si cette page ne suffit pas, décrivez le problème en quelques mots (ce que vous avez essayé, et l'erreur)."

msgid "I take reports in private. Who are you reporting? Give their nickname if you know it, then describe what happened. Do not discuss this in a public channel."
msgstr "Je prends les signalements en privé. Qui signalez-vous ? Donnez son pseudo si vous le connaissez, puis décrivez ce qui s'est passé. N'en discutez pas sur un salon public."

#, c-format
msgid "I take reports in private. I have the nickname %s. Describe what happened (where, when, and why). Do not discuss this in a public channel."
msgstr "Je prends les signalements en privé. J'ai le pseudo %s. Décrivez ce qui s'est passé (où, quand, et pourquoi). N'en discutez pas sur un salon public."

#, c-format
msgid "Describe what happened (where, when, and why you are reporting %s)."
msgstr "Décrivez ce qui s'est passé (où, quand, et pourquoi vous signalez %s)."

msgid "Please describe what happened (where, when, and why)."
msgstr "Décrivez ce qui s'est passé (où, quand, et pourquoi)."

msgid "I have noted that. Who are you reporting? Give their nickname, or say you do not know it."
msgstr "C'est noté. Qui signalez-vous ? Donnez son pseudo, ou dites si vous ne le connaissez pas."

msgid "Who are you reporting? Give their nickname. You can also describe what happened."
msgstr "Qui signalez-vous ? Donnez son pseudo. Vous pouvez aussi décrire ce qui s'est passé."

msgid "To file a report, type REPORT nick [#channel] reason (or SIGNALER). Do not discuss reports in public. After the ticket is open, send any evidence here by private message."
msgstr "Pour déposer un signalement, tapez REPORT pseudo [#salon] raison (ou SIGNALER). Ne discutez pas des signalements en public. Une fois le ticket ouvert, envoyez les preuves ici en message privé."

#, c-format
msgid "You already have open report ticket #%u. Your message has been added to it."
msgstr "Vous avez déjà le ticket de signalement #%u ouvert. Votre message y a été ajouté."

msgid "If you have screenshots, logs, or extra details, send them now as private messages."
msgstr "Si vous avez des captures d'écran, des journaux ou d'autres détails, envoyez-les maintenant en messages privés."

#, c-format
msgid ""
"%s is the help desk. Describe your problem in a private message; a ticket is opened only once your request is clear.\n"
"Helpers work from %s. User commands: WAIT (ATTENDRE), STATUS (STATUT), CANCEL (ANNULER)."
msgstr ""
"%s est le service d'aide. Décrivez votre problème en message privé ; un ticket n'est ouvert que lorsque votre demande est claire.\n"
"L'équipe travaille depuis %s. Commandes utilisateur : WAIT (ATTENDRE), STATUS (STATUT), CANCEL (ANNULER)."

#, c-format
msgid ""
"%s is the report desk. Describe the report in a private message; a ticket is opened once we know who and what happened. Do not discuss it in public.\n"
"Reports are handled by %s. User commands: WAIT, STATUS, CANCEL."
msgstr ""
"%s est le service de signalement. Décrivez le signalement en message privé ; un ticket est ouvert une fois que l'on sait qui et ce qui s'est passé. N'en discutez pas en public.\n"
"Les signalements sont traités par %s. Commandes utilisateur : WAIT, STATUS, CANCEL."

#, c-format
msgid ""
"%s is the operator help desk. Tickets opened via %s and %s are delivered here.\n"
"Helper commands: LIST, NEXT, PICKUP, SHOW, CLOSE, REOPEN, ADDNOTE, REASSIGN, JOIN, PART, BOTLIST, AUTOADD, AUTODEL, AUTOLIST."
msgstr ""
"%s est le service opérateurs. Les tickets ouverts via %s et %s arrivent ici.\n"
"Commandes de l'équipe : LIST, NEXT, PICKUP, SHOW, CLOSE, REOPEN, ADDNOTE, REASSIGN, JOIN, PART, BOTLIST, AUTOADD, AUTODEL, AUTOLIST."

#, c-format
msgid ""
"French aliases: LISTE, SUIVANT, PRENDRE, VOIR, FERMER, REOUVRIR, NOTE, REASSIGNER, AJOUTER, RETIRER, BOTS, AJOUTAUTO, SUPPRIAUTO, LISTAUTO.\n"
"Queues: HELP (AIDE) and REPORT (SIGNAL). JOIN / PART add or remove %s and %s on channels. AUTOADD / AUTODEL / AUTOLIST manage private-message keyword replies."
msgstr ""
"Alias français : LISTE, SUIVANT, PRENDRE, VOIR, FERMER, REOUVRIR, NOTE, REASSIGNER, AJOUTER, RETIRER, BOTS, AJOUTAUTO, SUPPRIAUTO, LISTAUTO.\n"
"Files : HELP (AIDE) et REPORT (SIGNAL). JOIN / PART ajoutent ou retirent %s et %s sur les salons. AUTOADD / AUTODEL / AUTOLIST gèrent les réponses automatiques en message privé."

msgid ""
"Helper commands: LIST, NEXT, PICKUP, SHOW, CLOSE, ADDNOTE, REASSIGN.\n"
"French aliases: LISTE, SUIVANT, PRENDRE, VOIR, FERMER, NOTE, REASSIGNER."
msgstr ""
"Commandes de l'équipe : LIST, NEXT, PICKUP, SHOW, CLOSE, ADDNOTE, REASSIGN.\n"
"Alias français : LISTE, SUIVANT, PRENDRE, VOIR, FERMER, NOTE, REASSIGNER."

#, c-format
msgid "Welcome to %s. Send a private message to %s to request help. A ticket is opened only after we understand your problem."
msgstr "Bienvenue sur %s. Envoyez un message privé à %s pour demander de l'aide. Un ticket n'est ouvert qu'une fois votre problème compris."

#, c-format
msgid "Welcome to %s. Send a private message to %s to file a report. Describe what happened; no special command is needed. Do not discuss reports in public."
msgstr "Bienvenue sur %s. Envoyez un message privé à %s pour déposer un signalement. Décrivez ce qui s'est passé ; aucune commande particulière n'est nécessaire. Ne discutez pas des signalements en public."

#, c-format
msgid "%s — opener %s has disconnected; the ticket stays open."
msgstr "%s — %s s'est déconnecté ; le ticket reste ouvert."

#, c-format
msgid "%s — opener %s has left %s; the ticket stays open."
msgstr "%s — %s a quitté %s ; le ticket reste ouvert."

#, c-format
msgid "Ticket #%u assigned to %s."
msgstr "Ticket #%u attribué à %s."

#, c-format
msgid "Helper %s has taken your ticket #%u. You have been given voice on %s."
msgstr "L'aidant %s a pris votre ticket #%u. Vous avez reçu le voice sur %s."

#, c-format
msgid "Helper %s has taken your ticket #%u. Join %s to talk with them; you will be given voice there."
msgstr "L'aidant %s a pris votre ticket #%u. Rejoignez %s pour lui parler ; vous y recevrez le voice."

#, c-format
msgid "%s — assigned to %s by %s"
msgstr "%s — attribué à %s par %s"

msgid "Show your ticket status / position in the queue"
msgstr "Afficher l'état de votre ticket / votre position dans la file"

#, c-format
msgid "You do not have an open ticket with %s."
msgstr "Vous n'avez pas de ticket ouvert auprès de %s."

#, c-format
msgid "Ticket #%u is being handled by %s."
msgstr "Le ticket #%u est pris en charge par %s."

#, c-format
msgid "Ticket #%u is waiting. Approximate position: %u."
msgstr "Le ticket #%u est en attente. Position approximative : %u."

msgid "Shows whether you have an open ticket and your position in the waiting list."
msgstr "Indique si vous avez un ticket ouvert et votre position dans la file d'attente."

msgid "Cancel your ticket if it has not been taken yet"
msgstr "Annuler votre ticket s'il n'a pas encore été pris"

#, c-format
msgid "Ticket #%u has already been taken and can only be closed by a helper."
msgstr "Le ticket #%u a déjà été pris et ne peut être fermé que par un aidant."

#, c-format
msgid "Ticket #%u has been cancelled."
msgstr "Le ticket #%u a été annulé."

#, c-format
msgid "%s — cancelled by %s"
msgstr "%s — annulé par %s"

msgid "Cancels your ticket if no helper has taken it yet."
msgstr "Annule votre ticket si aucun aidant ne l'a encore pris."

msgid "File a report against a user"
msgstr "Déposer un signalement contre un utilisateur"

msgid "nick [#channel] reason"
msgstr "pseudo [#salon] raison"

#, c-format
msgid "Use %s to file a report."
msgstr "Utilisez %s pour déposer un signalement."

msgid "You can also just describe the report in a private message; a ticket opens automatically once the nickname and the facts are clear. Do not discuss the report in a public channel. Extra evidence can be sent afterwards as private messages. The reported user is not notified."
msgstr "Vous pouvez aussi simplement décrire le signalement en message privé ; un ticket s'ouvre automatiquement une fois le pseudo et les faits connus. N'en discutez pas dans un salon public. Les preuves supplémentaires peuvent être envoyées ensuite en messages privés. La personne signalée n'est pas prévenue."

msgid "List tickets"
msgstr "Lister les tickets"

msgid "[UNASSIGNED | ASSIGNED | ME | ALL | CLOSED]"
msgstr "[UNASSIGNED | ASSIGNED | ME | ALL | CLOSED]"

msgid "ID"
msgstr "N°"

msgid "Queue"
msgstr "File"

msgid "Status"
msgstr "État"

msgid "Opener"
msgstr "Demandeur"

msgid "Helper"
msgstr "Aidant"

msgid "Summary"
msgstr "Résumé"

msgid "{id} ({queue}/{status}) {opener} — {summary}"
msgstr "{id} ({queue}/{status}) {opener} — {summary}"

msgid "waiting"
msgstr "en attente"

#, c-format
msgid "waiting on %s"
msgstr "en attente de traitement par %s"

msgid "Closed"
msgstr "Fermé"

#, c-format
msgid "Closed (%s)"
msgstr "Fermé (%s)"

#, c-format
msgid "Reminder — %u waiting, %u being handled:"
msgstr "Rappel — %u en attente, %u en traitement :"

#, c-format
msgid "%s — %s — %s: %s"
msgstr "%s — %s — %s : %s"

#, c-format
msgid "...and %u more open ticket(s). Use LIST."
msgstr "...et %u autre(s) ticket(s) ouvert(s). Utilisez LIST."

msgid "No tickets match that filter."
msgstr "Aucun ticket ne correspond à ce filtre."

msgid "Lists tickets. Default: waiting, assigned, and closed tickets from both queues. Assigned tickets stay listed as waiting on the helper; closed tickets stay listed as Closed. Prefix with HELP or REPORT to filter a queue. UNASSIGNED, ASSIGNED, ME, ALL, and CLOSED still work as filters."
msgstr "Liste les tickets. Par défaut : tickets en attente, en traitement et fermés des deux files. Un ticket attribué reste visible (en attente de traitement par l'aidant) ; un ticket fermé reste visible (Fermé). Préfixer par HELP ou REPORT pour une file. UNASSIGNED, ASSIGNED, ME, ALL et CLOSED restent disponibles."

msgid "Lists tickets for this bot's queue. Helpers see unassigned tickets by default."
msgstr "Liste les tickets. Par défaut : tickets en attente et en traitement des deux files."

msgid "Take the oldest waiting ticket"
msgstr "Prendre le plus ancien ticket en attente"

msgid "There are no waiting tickets."
msgstr "Il n'y a aucun ticket en attente."

#, c-format
msgid "Opener: %s (%s) — %s"
msgstr "Demandeur : %s (%s) — %s"

msgid "Takes the oldest unassigned ticket in this queue."
msgstr "Prend le plus ancien ticket non attribué de cette file."

msgid "Take a specific ticket"
msgstr "Prendre un ticket précis"

msgid "id|nick"
msgstr "id|pseudo"

msgid "Ticket not found."
msgstr "Ticket introuvable."

#, c-format
msgid "Ticket #%u is closed."
msgstr "Le ticket #%u est fermé."

#, c-format
msgid "Ticket #%u is closed. Use REOPEN %u to restore it."
msgstr "Le ticket #%u est fermé. Utilisez REOPEN %u pour le rouvrir."

msgid "Takes ticket id or the open ticket of nick."
msgstr "Prend le ticket id ou le ticket ouvert de pseudo."

msgid "Show a ticket"
msgstr "Afficher un ticket"

msgid "id"
msgstr "id"

#, c-format
msgid "Ticket #%u (%s) — %s"
msgstr "Ticket #%u (%s) — %s"

#, c-format
msgid "Opener: %s (%s) account: %s"
msgstr "Demandeur : %s (%s) compte : %s"

#, c-format
msgid "Target: %s"
msgstr "Cible : %s"

#, c-format
msgid "Channel: %s"
msgstr "Salon : %s"

#, c-format
msgid "Opened: %s"
msgstr "Ouvert : %s"

#, c-format
msgid "Closed: %s (%s)"
msgstr "Fermé : %s (%s)"

#, c-format
msgid "Helper: %s"
msgstr "Aidant : %s"

#, c-format
msgid "Summary: %s"
msgstr "Résumé : %s"

msgid "Messages:"
msgstr "Messages :"

msgid "Shows the full ticket, including private messages and helper notes. Closed tickets stay available here and in LIST CLOSED."
msgstr "Affiche le ticket complet, y compris les messages privés et les notes des aidants. Les tickets fermés restent consultables ici et avec LIST CLOSED."

msgid "Close a ticket"
msgstr "Fermer un ticket"

msgid "id [reason]"
msgstr "id [raison]"

#, c-format
msgid "Ticket #%u is already closed."
msgstr "Le ticket #%u est déjà fermé."

#, c-format
msgid "Ticket #%u closed."
msgstr "Ticket #%u fermé."

#, c-format
msgid "Your ticket #%u has been closed."
msgstr "Votre ticket #%u a été fermé."

#, c-format
msgid "Your ticket #%u has been closed: %s"
msgstr "Votre ticket #%u a été fermé : %s"

#, c-format
msgid "%s — closed by %s (%s)"
msgstr "%s — fermé par %s (%s)"

#, c-format
msgid "Your ticket #%u has expired because it was inactive."
msgstr "Votre ticket #%u a expiré faute d'activité."

#, c-format
msgid "%s — expired (inactive)"
msgstr "%s — expiré (inactif)"

msgid "Closes a ticket. The opener is notified. The ticket stays in LIST CLOSED and can be restored with REOPEN."
msgstr "Ferme un ticket. Le demandeur est prévenu. Le ticket reste dans LIST CLOSED et peut être restauré avec REOPEN."

msgid "Reopen a closed ticket"
msgstr "Rouvrir un ticket fermé"

#, c-format
msgid "Ticket #%u is not closed."
msgstr "Le ticket #%u n'est pas fermé."

#, c-format
msgid "Cannot reopen ticket #%u: %s already has open ticket #%u."
msgstr "Impossible de rouvrir le ticket #%u : %s a déjà le ticket ouvert #%u."

#, c-format
msgid "Ticket #%u reopened and assigned to %s."
msgstr "Ticket #%u rouvert et attribué à %s."

#, c-format
msgid "Your ticket #%u has been reopened. Helper %s will continue with you on %s."
msgstr "Votre ticket #%u a été rouvert. L'aidant %s continue avec vous sur %s."

#, c-format
msgid "Your ticket #%u has been reopened (%s). Helper %s will continue with you on %s."
msgstr "Votre ticket #%u a été rouvert (%s). L'aidant %s continue avec vous sur %s."

#, c-format
msgid "%s — reopened by %s, assigned to %s"
msgstr "%s — rouvert par %s, attribué à %s"

msgid "Restores a closed ticket with its history and assigns it to you. The opener is notified."
msgstr "Restaure un ticket fermé avec son historique et vous l'attribue. Le demandeur est prévenu."

msgid "Add an internal note to a ticket"
msgstr "Ajouter une note interne à un ticket"

msgid "id text"
msgstr "id texte"

#, c-format
msgid "Note added to ticket #%u."
msgstr "Note ajoutée au ticket #%u."

msgid "Adds a helper-only note. The opener does not see it."
msgstr "Ajoute une note visible uniquement par l'équipe. Le demandeur ne la voit pas."

msgid "Reassign a ticket to another helper"
msgstr "Réattribuer un ticket à un autre aidant"

msgid "id helper"
msgstr "id aidant"

msgid "Gives the ticket to another helper."
msgstr "Donne le ticket à un autre aidant."

msgid "Helper commands"
msgstr "Commandes de l'équipe"

msgid "Add AideMoi or SignalMoi to a channel"
msgstr "Ajouter AideMoi ou SignalMoi sur un salon"

msgid "Remove AideMoi or SignalMoi from a channel"
msgstr "Retirer AideMoi ou SignalMoi d'un salon"

msgid "List HelpServ client bots and their channels"
msgstr "Lister les bots HelpServ et leurs salons"

#, c-format
msgid "Use %s to handle tickets."
msgstr "Utilisez %s pour traiter les tickets."

#, c-format
msgid "Bot %s cannot be assigned with BotServ. Use /msg %s JOIN %s %s."
msgstr "Le bot %s ne peut pas être assigné avec BotServ. Utilisez /msg %s JOIN %s %s."

#, c-format
msgid "%s has been added to %s."
msgstr "%s a été ajouté sur %s."

#, c-format
msgid "%s status on %s updated."
msgstr "Statut de %s sur %s mis à jour."

msgid "Specify a channel, for example +#channel or #channel voice."
msgstr "Indiquez un salon, par exemple +#salon ou #salon voice."

#, c-format
msgid "%s is already on its home channel %s. Change prefix in helpserv.conf instead."
msgstr "%s est déjà sur son salon d'origine %s. Changez prefix dans helpserv.conf."

msgid "Adds the help or report bot to a channel. Optional prefix: ~ owner, & admin, @ op, %% halfop, + voice, or names (admin, voice, none). Default comes from helpserv.conf. Example: JOIN AideMoi +#salon. This does not replace a BotServ assignment."
msgstr "Ajoute le bot d'aide ou de signalement sur un salon. Préfixe optionnel : ~ fondateur, & admin, @ op, %% halfop, + voice, ou un nom (admin, voice, none). La valeur par défaut vient de helpserv.conf. Exemple : JOIN AideMoi +#salon. Cela ne remplace pas une assignation BotServ."

#, c-format
msgid "%s has been removed from %s."
msgstr "%s a été retiré de %s."

msgid "Add a keyword reply for AideMoi or SignalMoi"
msgstr "Ajouter une réponse automatique pour AideMoi ou SignalMoi"

msgid "Delete a keyword reply for AideMoi or SignalMoi"
msgstr "Supprimer une réponse automatique pour AideMoi ou SignalMoi"

msgid "List keyword replies for AideMoi and SignalMoi"
msgstr "Lister les réponses automatiques d'AideMoi et SignalMoi"

#, c-format
msgid "Use AUTOADD %s keys : reply. Separate keys with a comma or /."
msgstr "Utilisez AUTOADD %s mots-clés : réponse. Séparez les mots-clés par une virgule ou /."

msgid "Could not add that keyword reply."
msgstr "Impossible d'ajouter cette réponse automatique."

#, c-format
msgid "Reply #%u added for %s. Keys: %s"
msgstr "Réponse #%u ajoutée pour %s. Mots-clés : %s"

msgid "Adds a private-message keyword reply for AideMoi or SignalMoi. If a user writes a matching phrase in private, the bot sends the reply instead of opening a ticket immediately. Separate several keys with a comma or /. Example: AUTOADD AideMoi bannis, je suis banni : Vous pouvez trouver les règles ici : https://example.invalid/"
msgstr "Ajoute une réponse automatique en message privé pour AideMoi ou SignalMoi. Si un utilisateur écrit une phrase correspondante en privé, le bot envoie la réponse au lieu d'ouvrir un ticket tout de suite. Séparez plusieurs mots-clés par une virgule ou /. Exemple : AUTOADD AideMoi bannis, je suis banni : Vous pouvez trouver les règles ici : https://www.reseau-entrenous.fr/aide/"

#, c-format
msgid "No keyword reply matched %s on that bot."
msgstr "Aucune réponse automatique ne correspond à %s pour ce bot."

#, c-format
msgid "Deleted %u keyword reply."
msgid_plural "Deleted %u keyword replies."
msgstr[0] "%u réponse automatique supprimée."
msgstr[1] "%u réponses automatiques supprimées."

msgid "Deletes a keyword reply. Use the id from AUTOLIST, or one of the keys. Example: AUTODEL AideMoi 3"
msgstr "Supprime une réponse automatique. Utilisez l'id de AUTOLIST, ou l'un des mots-clés. Exemple : AUTODEL AideMoi 3"

#, c-format
msgid "#%u %s — %s → %s"
msgstr "#%u %s — %s → %s"

msgid "No keyword replies."
msgstr "Aucune réponse automatique."

msgid "No keyword replies for that bot."
msgstr "Aucune réponse automatique pour ce bot."

msgid "Lists keyword replies. Optional bot name (AideMoi or SignalMoi) filters the list."
msgstr "Liste les réponses automatiques. Le nom du bot (AideMoi ou SignalMoi) est optionnel pour filtrer."


