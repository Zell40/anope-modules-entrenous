msgstr "id"

#, c-format
msgid "Ticket #%u (%s) — %s"
msgstr "Ticket #%u (%s) — %s"

#, c-format
msgid "Opener: %s (%s) account: %s"
msgstr "Demandeur : %s (%s) compte : %s"

