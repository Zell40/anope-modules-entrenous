msgid "Helper: %s"
msgstr "Aidant : %s"

#, c-format
msgid "Summary: %s"
msgstr "Résumé : %s"

msgid "Messages:"
msgstr "Messages :"

msgid "Shows the full ticket, including private messages and helper notes."
msgstr "Affiche le ticket complet, y compris les messages privés et les notes des aidants."

msgid "Close a ticket"
msgstr "Fermer un ticket"

msgid "id [reason]"
msgstr "id [raison]"

#, c-format
msgid "Ticket #%u is already closed."
msgstr "Le ticket #%u est déjà fermé."

#, c-format
msgid "Ticket #%u closed."
msgstr "Ticket #%u fermé."

#, c-format
msgid "Your ticket #%u has been closed."
msgstr "Votre ticket #%u a été fermé."

#, c-format
msgid "Your ticket #%u has been closed: %s"
msgstr "Votre ticket #%u a été fermé : %s"

#, c-format
