msgstr "{id} ({queue}/{status}) {opener} — {summary}"

msgid "No tickets match that filter."
msgstr "Aucun ticket ne correspond à ce filtre."

msgid "Lists tickets for this bot's queue. Helpers see unassigned tickets by default."
msgstr "Liste les tickets de la file de ce robot. Les aidants voient les tickets non attribués par défaut."

msgid "Take the oldest waiting ticket"
msgstr "Prendre le plus ancien ticket en attente"

msgid "There are no waiting tickets."
msgstr "Il n'y a aucun ticket en attente."

#, c-format
msgid "Opener: %s (%s) — %s"
msgstr "Demandeur : %s (%s) — %s"

msgid "Takes the oldest unassigned ticket in this queue."
msgstr "Prend le plus ancien ticket non attribué de cette file."

msgid "Take a specific ticket"
msgstr "Prendre un ticket précis"

msgid "id|nick"
msgstr "id|pseudo"

msgid "Ticket not found."
msgstr "Ticket introuvable."

#, c-format
msgid "Ticket #%u is closed."
msgstr "Le ticket #%u est fermé."

msgid "Takes ticket id or the open ticket of nick."
msgstr "Prend le ticket id ou le ticket ouvert de pseudo."

msgid "Show a ticket"
msgstr "Afficher un ticket"

