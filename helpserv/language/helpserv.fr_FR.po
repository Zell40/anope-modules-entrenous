msgstr "%s — fermé par %s (%s)"

msgid "Closes a ticket. The opener is notified."
msgstr "Ferme un ticket. Le demandeur est prévenu."

msgid "Add an internal note to a ticket"
msgstr "Ajouter une note interne à un ticket"

msgid "id text"
msgstr "id texte"

#, c-format
msgid "Note added to ticket #%u."
msgstr "Note ajoutée au ticket #%u."

msgid "Adds a helper-only note. The opener does not see it."
msgstr "Ajoute une note visible uniquement par l'équipe. Le demandeur ne la voit pas."

msgid "Reassign a ticket to another helper"
msgstr "Réattribuer un ticket à un autre aidant"

msgid "id helper"
msgstr "id aidant"

msgid "Gives the ticket to another helper."
msgstr "Donne le ticket à un autre aidant."

msgid "Helper commands"
msgstr "Commandes de l'équipe"

msgid "Add AideMoi or SignalMoi to a channel"
msgstr "Ajouter AideMoi ou SignalMoi sur un salon"

msgid "Remove AideMoi or SignalMoi from a channel"
msgstr "Retirer AideMoi ou SignalMoi d'un salon"

msgid "List HelpServ client bots and their channels"
msgstr "Lister les bots HelpServ et leurs salons"

#, c-format
msgid "Use %s to handle tickets."
msgstr "Utilisez %s pour traiter les tickets."

#, c-format
msgid "Bot %s cannot be assigned with BotServ. Use /msg %s JOIN %s %s."
msgstr "Le bot %s ne peut pas être assigné avec BotServ. Utilisez /msg %s JOIN %s %s."

#, c-format
msgid "%s has been added to %s."
msgstr "%s a été ajouté sur %s."

#, c-format
msgid "%s has been removed from %s."
msgstr "%s a été retiré de %s."


